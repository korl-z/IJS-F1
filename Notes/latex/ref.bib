	keywords = {Condensed Matter - Mesoscale and Nanoscale Physics, Physics - Optics},
	file = {PDF:/home/kzeleznikar/Zotero/storage/IJQW9BJV/Davari in Kargarian - 2025 - Probing the collective excitations of excitonic insulators in an optical cavity.pdf:application/pdf},
}

